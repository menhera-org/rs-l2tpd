diff --git a/src/bin/rs-l2tpd/fdstore.rs b/src/bin/rs-l2tpd/fdstore.rs
index 7dd361a..3cbd98d 100644
--- a/src/bin/rs-l2tpd/fdstore.rs
+++ b/src/bin/rs-l2tpd/fdstore.rs
@@ -586,3 +586,162 @@ mod completion_tests {
         std::mem::forget(fd); // Its descriptor was deliberately closed above.
     }
 }
+
+#[cfg(test)]
+#[cfg_attr(coverage_nightly, coverage(off))]
+mod inheritance_tests {
+    use super::*;
+
+    /// spec: P14, P17, P23, G14
+    #[test]
+    fn malformed_announcements_and_close_fallback_preserve_descriptor_ownership() {
+        const CHILD: &str = "PHASE6_INHERIT_CASE";
+        if let Ok(case) = std::env::var(CHILD) {
+            // This child runs only this case; no other test accesses its environment.
+            unsafe {
+                std::env::set_var("LISTEN_PID", std::process::id().to_string());
+                std::env::set_var("LISTEN_FDS", "1");
+                std::env::set_var("LISTEN_FDNAMES", "t10");
+                std::env::set_var("NOTIFY_SOCKET", "@example");
+                std::env::set_var("FDSTORE", "16");
+            }
+            let file = std::fs::File::open("/dev/null").unwrap();
+            let source = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_DUPFD_CLOEXEC, 64) };
+            assert!(source >= 64);
+            drop(file);
+            for fd in [3, 40] {
+                assert_eq!(unsafe { libc::dup3(source, fd, 0) }, fd);
+            }
+            assert_eq!(unsafe { libc::close(source) }, 0);
+            let diagnostic = match case.as_str() {
+                "invalid-count" | "negative-count" | "excess-count" => {
+                    unsafe {
+                        std::env::set_var(
+                            "LISTEN_FDS",
+                            match case.as_str() {
+                                "invalid-count" => "bad",
+                                "negative-count" => "-1",
+                                _ => "1048574",
+                            },
+                        );
+                    }
+                    Some(if case == "invalid-count" {
+                        "invalid LISTEN_FDS"
+                    } else {
+                        "invalid LISTEN_FDS count"
+                    })
+                }
+                "missing-name" | "extra-name" | "control-name" => {
+                    unsafe {
+                        std::env::set_var(
+                            "LISTEN_FDNAMES",
+                            match case.as_str() {
+                                "missing-name" => "",
+                                "extra-name" => "t10:t11",
+                                _ => "t10\nFDSTORE=0",
+                            },
+                        );
+                    }
+                    Some(
+                        "malformed descriptor handover: names unavailable; store cleanup cannot be confirmed",
+                    )
+                }
+                "missing-fd" => {
+                    assert_eq!(unsafe { libc::close(3) }, 0);
+                    Some("announced descriptor is not open; store cleanup cannot be confirmed")
+                }
+                "foreign-pid" => {
+                    unsafe {
+                        std::env::set_var("LISTEN_PID", "0");
+                        std::env::set_var("LISTEN_FDS", "bad");
+                        std::env::set_var("FDSTORE", "bad");
+                    }
+                    None
+                }
+                "fallback" | "fallback-limit-error" => {
+                    let limit = libc::rlimit {
+                        rlim_cur: 16,
+                        rlim_max: 64,
+                    };
+                    assert_eq!(unsafe { libc::setrlimit(libc::RLIMIT_NOFILE, &limit) }, 0);
+                    let mut syscalls = vec![libc::SYS_close_range];
+                    if case == "fallback-limit-error" {
+                        syscalls.push(libc::SYS_prlimit64);
+                        #[cfg(any(target_arch = "x86_64", target_arch = "powerpc64"))]
+                        syscalls.push(libc::SYS_getrlimit);
+                    }
+                    // Profile output opens after inherit; leave its file operations usable.
+                    crate::syscall_fault::on_exec(&syscalls, libc::EIO)().unwrap();
+                    None
+                }
+                "valid" => None,
+                _ => panic!("unknown inheritance case"),
+            };
+            let result = inherit();
+            let probe = |fd| unsafe { libc::fcntl(fd, libc::F_GETFD) };
+            if let Some(diagnostic) = diagnostic {
+                assert_eq!(result.err().unwrap().to_string(), diagnostic);
+            } else if case == "fallback-limit-error" {
+                assert_eq!(result.err().unwrap().raw_os_error(), Some(libc::EIO));
+                assert!(probe(3) >= 0 && probe(40) >= 0);
+                assert!(std::env::var_os("LISTEN_PID").is_some());
+                return;
+            } else {
+                let inherited = result.unwrap();
+                assert_eq!(inherited.notify, Some("@example".into()));
+                if case == "foreign-pid" {
+                    assert!(inherited.sockets.is_empty());
+                    assert_eq!(inherited.capacity, 0);
+                    assert_eq!(probe(3), -1);
+                } else {
+                    assert_eq!(inherited.capacity, 16);
+                    assert_eq!(inherited.sockets.len(), 1);
+                    assert_eq!(inherited.sockets[0].name(), "t10");
+                    assert_eq!(inherited.sockets[0].fd().as_raw_fd(), 3);
+                    assert_eq!(probe(3) & libc::FD_CLOEXEC, libc::FD_CLOEXEC);
+                }
+                drop(inherited);
+            }
+            let early = case.ends_with("count");
+            assert_eq!(probe(40) >= 0, early);
+            assert_eq!(probe(3) >= 0, early);
+            for name in ["LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES"] {
+                assert_eq!(std::env::var_os(name).is_some(), early);
+            }
+            return;
+        }
+        for case in [
+            "valid",
+            "invalid-count",
+            "negative-count",
+            "excess-count",
+            "missing-name",
+            "extra-name",
+            "control-name",
+            "missing-fd",
+            "foreign-pid",
+            "fallback",
+            "fallback-limit-error",
+        ] {
+            let mut child = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "fdstore::inheritance_tests::malformed_announcements_and_close_fallback_preserve_descriptor_ownership", "--nocapture", "--test-threads=1"])
+                .env(CHILD, case)
+                .stdout(std::process::Stdio::piped())
+                .stderr(std::process::Stdio::piped())
+                .spawn().unwrap();
+            let deadline = Instant::now() + Duration::from_secs(5);
+            while child.try_wait().unwrap().is_none() {
+                if Instant::now() >= deadline {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                    panic!("inheritance case {case} exceeded its deadline");
+                }
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            let output = child.wait_with_output().unwrap();
+            assert!(output.status.success(), "{case}: {output:?}");
+            assert!(!String::from_utf8_lossy(&output.stderr).contains("LLVM Profile Error"));
+            println!("INHERITANCE_CASE_VERIFIED={case}");
+        }
+    }
+}
