+    /// spec: P27
+    #[test]
+    fn failed_install_steps_preserve_existing_files_and_attempt_the_remaining_steps() {
+        for case in ["missing-source", "unit-directory", "configuration-parent"] {
+            let dir = crate::testdir::Dir::new();
+            let source = dir.path().join("source");
+            fs::write(&source, "candidate").unwrap();
+            let binary = dir.path().join("usr/local/sbin/rs-l2tpd");
+            let unit_path = dir
+                .path()
+                .join("usr/local/lib/systemd/system/rs-l2tpd.service");
+            let config = dir.path().join("etc/rs-l2tpd.toml");
+            directories(binary.parent().unwrap()).unwrap();
+            fs::write(&binary, "installed").unwrap();
+            let original_inode = fs::metadata(&binary).unwrap().ino();
+            match case {
+                "missing-source" => fs::remove_file(&source).unwrap(),
+                "unit-directory" => directories(&unit_path).unwrap(),
+                "configuration-parent" => fs::write(dir.path().join("etc"), "keep").unwrap(),
+                _ => unreachable!(),
+            }
+            assert!(!install_files(dir.path(), &source), "{case}");
+            if case == "missing-source" {
+                assert_eq!(fs::read_to_string(&binary).unwrap(), "installed");
+                assert_eq!(fs::metadata(&binary).unwrap().ino(), original_inode);
+            } else {
+                assert_eq!(fs::read_to_string(&binary).unwrap(), "candidate");
+            }
+            if case == "unit-directory" {
+                assert!(unit_path.is_dir());
+                assert!(fs::read_dir(&unit_path).unwrap().next().is_none());
+            } else {
+                assert_eq!(
+                    fs::read_to_string(&unit_path).unwrap(),
+                    unit("/usr/local/sbin/rs-l2tpd")
+                );
+            }
+            if case == "configuration-parent" {
+                assert_eq!(fs::read_to_string(dir.path().join("etc")).unwrap(), "keep");
+            } else {
+                assert_eq!(
+                    fs::read(&config).unwrap(),
+                    include_bytes!("../../../contrib/rs-l2tpd.toml")
+                );
+            }
+            match case {
+                "missing-source" => fs::write(&source, "candidate").unwrap(),
+                "unit-directory" => fs::remove_dir(&unit_path).unwrap(),
+                "configuration-parent" => fs::remove_file(dir.path().join("etc")).unwrap(),
+                _ => unreachable!(),
+            }
+            assert!(install_files(dir.path(), &source), "{case}");
+            assert_eq!(fs::read_to_string(&binary).unwrap(), "candidate");
+            assert_eq!(
+                fs::read_to_string(&unit_path).unwrap(),
+                unit("/usr/local/sbin/rs-l2tpd")
+            );
+            assert_eq!(
+                fs::read(&config).unwrap(),
+                include_bytes!("../../../contrib/rs-l2tpd.toml")
+            );
+        }
+    }
 }
