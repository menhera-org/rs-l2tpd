#!/bin/sh
set -eu
repo=CHECKOUT
cd "$repo"
record=$repo/target/verification/release-candidate/coverage
profiles=$repo/target/release-candidate-coverage-guest-profiles
limits=$repo/target/release-candidate-coverage-limit-profiles
kernel=$repo/target/release-candidate-coverage-kernel-root
test ! -e "$record"
test ! -e "$kernel"
mkdir -p "$record"
# Keep the stock kernel inputs immutable while the independent matrix fetches.
cp -Rp target/phase6-kernels/ubuntu-resolute-7.0.0-42.42/root "$kernel"
git --no-pager rev-parse HEAD > "$record/revision"
git --no-pager diff HEAD -- src tests Cargo.toml Cargo.lock > "$record/initial-source.patch"
test ! -s "$record/initial-source.patch"
rustc +nightly-2026-10-28 -vV > "$record/toolchain.log"
sh tools/coverage/calibrate.sh "$record/calibration" > "$record/calibration-driver.log" 2>&1
TEST_SEED=1 cargo +nightly-2026-10-28 llvm-cov --color never --locked --all-features --target x86_64-unknown-linux-gnu --branch --no-report > "$record/native.log" 2>&1
cargo +nightly-2026-10-28 llvm-cov report --target x86_64-unknown-linux-gnu --branch --json --output-path "$CARGO_LLVM_COV_TARGET_DIR/initial-export.json" > "$record/initial-export.log" 2>&1
tools/coverage/target/debug/phase6-coverage snapshot "$repo" "$record/source-and-mapping-inventory.json" "$CARGO_LLVM_COV_TARGET_DIR/initial-export.json" > "$record/snapshot.log" 2>&1
for seed in 2 3 4 5 6 7 8 9 10; do
    TEST_SEED=$seed cargo +nightly-2026-10-28 llvm-cov --color never --locked --all-features --target x86_64-unknown-linux-gnu --branch --no-report > "$record/native-$seed.log" 2>&1
done
sh tools/coverage/run-guest.sh "$record/native.log" "$kernel" "$record/guest" "$profiles" > "$record/guest-driver.log" 2>&1
for profile in "$profiles"/*.profraw; do cp "$profile" "$CARGO_LLVM_COV_TARGET_DIR/guest-${profile##*/}"; done
tests/docker/thread-limits.sh rs-l2tpd-coverage:phase6 "$CARGO_LLVM_COV_TARGET_DIR/x86_64-unknown-linux-gnu/debug/rs-l2tpd" "$record/thread-limits" "$limits" > "$record/thread-limits.log" 2>&1
docker run --rm --network none --mount "type=bind,source=$limits,target=/profiles" --entrypoint sh rs-l2tpd-coverage:phase6 -ec 'chmod a+r /profiles/*.profraw'
for profile in "$limits"/*.profraw; do cp "$profile" "$CARGO_LLVM_COV_TARGET_DIR/limit-${profile##*/}"; done
git --no-pager diff HEAD -- src tests Cargo.toml Cargo.lock > "$record/final-source.patch"
cmp "$record/initial-source.patch" "$record/final-source.patch"
cargo +nightly-2026-10-28 llvm-cov report --target x86_64-unknown-linux-gnu --branch --show-missing-lines > "$record/raw-coverage.log" 2>&1
cargo +nightly-2026-10-28 llvm-cov report --target x86_64-unknown-linux-gnu --branch --json --output-path "$CARGO_LLVM_COV_TARGET_DIR/combined-export.json" > "$record/combined-export.log" 2>&1
xz -c "$CARGO_LLVM_COV_TARGET_DIR/combined-export.json" > "$record/llvm-export.json.xz"
tools/coverage/target/debug/phase6-coverage check "$repo" "$record/source-and-mapping-inventory.json" "$CARGO_LLVM_COV_TARGET_DIR/combined-export.json" > "$record/merged-source-coverage.log" 2>&1
cat "$record/merged-source-coverage.log"
