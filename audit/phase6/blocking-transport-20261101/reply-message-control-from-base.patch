+#[cfg(all(test, feature = "fake-kernel"))]
+#[cfg_attr(coverage_nightly, coverage(off))]
+mod tests {
+    use super::*;
+    use crate::kernel::fake::FakeKernel;
+
+    /// spec: L5, L7, L9, G14
+    #[test]
+    fn unavailable_command_queues_return_the_original_error() {
+        let engine = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        let _entered = engine.enter();
+        let runtime = crate::runtime::Runtime::with_kernel(
+            FakeKernel::new(42),
+            Box::new(IphostResolve::default()),
+            vec![],
+        )
+        .map_err(|(error, _)| error)
+        .unwrap();
+        for closed in [false, true] {
+            let (commands, mut receiver) = tokio::sync::mpsc::channel(1);
+            let expected = if closed {
+                receiver.close();
+                tokio::sync::mpsc::error::TrySendError::Closed(()).to_string()
+            } else {
+                let (reply, _) = mpsc::sync_channel(1);
+                assert!(commands.try_send(Command::Requests(reply)).is_ok());
+                tokio::sync::mpsc::error::TrySendError::Full(()).to_string()
+            };
+            let mut service = Service {
+                control: runtime.control(),
+                commands: Some(commands),
+                thread: None,
+            };
+            for result in [
+                service.converge().map(|_| ()),
+                service.set_store_capacity(1),
+                service.take_requests().map(|_| ()),
+                service.run(Ok, |_| Ok(())),
+            ] {
+                assert!(
+                    matches!(&result, Err(Error::Other(message)) if message == &expected),
+                    "{result:?}"
+                );
+            }
+        }
+    }
+
+    /// spec: L5, L7, L9, G14
+    #[test]
+    fn an_abandoned_command_reply_returns_the_original_error() {
+        let engine = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        let _entered = engine.enter();
+        let runtime = crate::runtime::Runtime::with_kernel(
+            FakeKernel::new(42),
+            Box::new(IphostResolve::default()),
+            vec![],
+        )
+        .map_err(|(error, _)| error)
+        .unwrap();
+        let (commands, mut receiver) = tokio::sync::mpsc::channel(1);
+        let mut service = Service {
+            control: runtime.control(),
+            commands: Some(commands),
+            thread: None,
+        };
+        let worker = std::thread::spawn(move || {
+            assert!(matches!(
+                receiver.blocking_recv(),
+                Some(Command::Converge(_))
+            ));
+        });
+        let result = service.converge();
+        worker.join().unwrap();
+        assert!(
+            matches!(&result, Err(Error::Other(message)) if message == &mpsc::RecvError.to_string()),
+            "{result:?}"
+        );
+    }
+}
