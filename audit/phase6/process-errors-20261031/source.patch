+
+/// spec: P2, P4, P6, P16, P23, O1, R37
+#[test]
+#[ignore = "isolated process suite; container/guest cleanup also owns daemon descendants"]
+fn daemon_setup_failures_return_the_original_error_before_kernel_startup() {
+    use nix::libc;
+    let fork_syscalls = &[
+        #[cfg(any(
+            target_arch = "arm",
+            target_arch = "x86",
+            target_arch = "x86_64",
+            target_arch = "powerpc",
+            target_arch = "powerpc64",
+            target_arch = "s390x",
+            target_arch = "sparc",
+            target_arch = "sparc64",
+            target_arch = "mips",
+            target_arch = "mips64",
+            target_arch = "mips32r6",
+            target_arch = "mips64r6",
+            target_arch = "m68k"
+        ))]
+        libc::SYS_fork,
+        libc::SYS_clone,
+        libc::SYS_clone3,
+    ];
+    for (case, syscalls, error, diagnostic) in [
+        (
+            "streams",
+            &[libc::SYS_fcntl][..],
+            libc::EIO,
+            Some("standard streams:"),
+        ),
+        (
+            "directory",
+            &[libc::SYS_chdir][..],
+            libc::EACCES,
+            Some("chdir /:"),
+        ),
+        ("executable", &[libc::SYS_getcwd][..], libc::ENOENT, None),
+        ("pipe", &[libc::SYS_pipe2][..], libc::EMFILE, None),
+        ("fork", fork_syscalls, libc::EAGAIN, None),
+        ("session", &[libc::SYS_setsid][..], libc::EPERM, None),
+    ] {
+        let dir = Dir::new();
+        let config = config(&dir);
+        let pid = dir.path().join("pid");
+        fs::write(&pid, "sentinel").unwrap();
+        let mut command = start(&config, false, &pid);
+        if case == "executable" {
+            command.arg0("relative/rs-l2tpd");
+        }
+        let mut fault = syscall_fault::on_exec(syscalls, error);
+        let mut sockets = syscall_fault::on_exec(&[libc::SYS_socket], libc::EACCES);
+        let mut next_stage =
+            (case == "fork").then(|| syscall_fault::on_exec(&[libc::SYS_setsid], libc::EACCES));
+        // Filters are allocated in the parent; this hook only performs raw syscalls.
+        unsafe {
+            command.pre_exec(move || {
+                sockets()?;
+                if let Some(guard) = &mut next_stage {
+                    guard()?;
+                }
+                fault()
+            });
+        }
+        let mut process = Process::spawn(command);
+        let expected = format!("os error {error}");
+        let line = process.event(diagnostic.unwrap_or(&expected));
+        assert!(line.contains(&expected), "{case}: {line}");
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let status = loop {
+            if let Some(status) = process.child.try_wait().unwrap() {
+                break status;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "{case}: daemon parent did not exit"
+            );
+            std::thread::sleep(Duration::from_millis(5));
+        };
+        process.done = true;
+        assert_eq!(status.code(), Some(1), "{case}");
+        assert_eq!(fs::read_to_string(&pid).unwrap(), "sentinel");
+        println!("DAEMON_FAULT_CHECKED={case}");
+    }
+}
diff --git a/tests/service.rs b/tests/service.rs
index 682f502..47de6e4 100644
--- a/tests/service.rs
+++ b/tests/service.rs
@@ -1216,3 +1216,72 @@ fn panicking_kernel_initializer_returns_descriptors_to_the_caller() {
     assert_eq!(returned[0].fd().as_raw_fd(), original);
     assert!(returned[0].fd().try_clone().is_ok());
 }
+
+/// spec: L5, L8, L11, L7, G14, P16
+#[test]
+fn services_return_final_cleanup_query_errors_and_release_local_descriptors() {
+    for blocking in [false, true] {
+        let host = Host::new();
+        host.with(|k| k.set_tunnel_delete_delay(Duration::from_secs(10)));
+        let fail_cleanup = |control: rs_l2tpd::Control| {
+            assert!(!control.config().tunnels().is_empty());
+            let observer = control.clone();
+            let host = host.clone();
+            let advance = std::thread::spawn(move || {
+                // The empty snapshot follows retirement and its fixed deadline.
+                wait(|| observer.config().tunnels().is_empty());
+                host.with(|k| {
+                    k.advance(Duration::from_secs(2));
+                    // One query may already have captured the preceding time.
+                    k.fail_next("tunnel", nix::errno::Errno::EIO);
+                    k.fail_next("tunnel", nix::errno::Errno::EIO);
+                });
+                observer.shutdown();
+            });
+            control.shutdown();
+            advance
+        };
+        let error = if blocking {
+            let mut service = start(&host, config(10));
+            service.converge().unwrap();
+            host.with(|k| k.clear_ops());
+            let advance = fail_cleanup(service.control());
+            let result = service.run(Ok, |_| Ok(()));
+            advance.join().unwrap();
+            result.unwrap_err()
+        } else {
+            engine().block_on(async {
+                let runtime = Runtime::with_kernel(host.clone(), Box::new(NoDns), vec![]).unwrap();
+                let mut service = service::Service::with_runtime(config(10), runtime).unwrap();
+                service.converge().await.unwrap();
+                host.with(|k| k.clear_ops());
+                let advance = fail_cleanup(service.control());
+                let result = service.run(Ok, |_| Ok(())).await;
+                advance.join().unwrap();
+                result.unwrap_err()
+            })
+        };
+        let Error::Io(error) = error else {
+            panic!("unexpected failure: {error}")
+        };
+        assert_eq!(error.raw_os_error(), Some(nix::libc::EIO));
+        host.with(|k| {
+            assert_eq!(k.open_sockets(), 0);
+            k.advance(Duration::from_secs(10));
+            k.tick();
+            assert!(k.tunnel_socket(10).is_none());
+            assert!(k.session_index(10, 110).is_none());
+            let deleted = k
+                .ops()
+                .iter()
+                .position(|op| op.starts_with("delete "))
+                .unwrap();
+            let closed = k
+                .ops()
+                .iter()
+                .position(|op| op.starts_with("close "))
+                .unwrap();
+            assert!(deleted < closed);
+        });
+    }
+}
