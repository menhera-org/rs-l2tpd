set -eu
record=$PWD/audit/phase6/netlink-io-faults-20261101
profiles=$CARGO_LLVM_COV_TARGET_DIR/request-io-live-profiles
mkdir -p "$profiles"
chmod 777 "$profiles"
gnu=$(awk '/Running tests\/kernel\/linux.rs \(/ {line=$0;sub(/^.*Running tests\/kernel\/linux.rs \(/,"",line);sub(/\)$/,"",line);print line}' "$record/native.log")
musl=$(awk '/Executable tests\/kernel\/linux.rs \(/ {line=$0;sub(/^.*Executable tests\/kernel\/linux.rs \(/,"",line);sub(/\)$/,"",line);print line}' "$record/musl-linux-build.log")
for flavor in gnu musl; do
 if test "$flavor" = gnu; then unit=$gnu; else unit=$musl; fi
 case $unit in /*) ;; *) unit=$PWD/$unit ;; esac
 test -x "$unit"
 for repeat in 1 2 3; do
  set --
  if test "$flavor" = gnu; then set -- --mount "type=bind,source=$profiles,target=$profiles" --env "LLVM_PROFILE_FILE=$profiles/linux-$repeat-%p-%m.profraw"; fi
  {
   printf 'features: all; target: x86_64-unknown-linux-%s; repetition: %s; Docker privileged, network none; kernel-linux --ignored --test-threads=1 --nocapture\n' "$flavor" "$repeat"
   docker run --rm --privileged --network none "$@" --mount "type=bind,source=$PWD,target=$PWD,readonly" --entrypoint sh rs-l2tpd-coverage:phase6 -ec 'uname -r; exec "$1" --ignored --test-threads=1 --nocapture' run "$unit"
  } > "$record/linux-$flavor-$repeat.log" 2>&1
  grep -q 'test result: ok. 24 passed; 0 failed' "$record/linux-$flavor-$repeat.log"
 done
 control=$PWD/target/phase6-request-io-controls/kept-cap-x86_64-unknown-linux-$flavor
 result=0
 docker run --rm --privileged --network none --mount "type=bind,source=$PWD,target=$PWD,readonly" --entrypoint sh rs-l2tpd-coverage:phase6 -ec 'uname -r; exec "$1" --ignored --exact library_missing_net_admin_withholds_readiness_and_shutdown_still_succeeds --nocapture' run "$control" > "$record/control-kept-capability-$flavor.log" 2>&1 || result=$?
 test "$result" = 101
 grep -q 'test result: FAILED. 0 passed; 1 failed' "$record/control-kept-capability-$flavor.log"
done
docker run --rm --network none --mount "type=bind,source=$profiles,target=/profiles" --entrypoint sh rs-l2tpd-coverage:phase6 -ec 'chmod a+r /profiles/*.profraw'
cp "$profiles/"*.profraw "$CARGO_LLVM_COV_TARGET_DIR/"
printf 'REQUEST_IO_CAPABILITY_LIVE_RESULT=0\n'


set -eu
record=$PWD/audit/phase6/netlink-io-faults-20261101
unit=$(awk '/Running unittests src\/lib.rs \(/ {line=$0;sub(/^.*Running unittests src\/lib.rs \(/,"",line);sub(/\)$/,"",line);print line}' "$record/native.log")
case $unit in /*) ;; *) unit=$PWD/$unit ;; esac
test -x "$unit"
kernel_root=$PWD/target/phase6-kernels/ubuntu-noble-6.8.0-147.147/root
for repeat in 1 2 3; do
 profiles=$PWD/target/phase6-request-io-profiles/guest-final-$repeat
 sh "$record/run-qemu.sh" "$unit" "$kernel_root" "$record/guest-final-$repeat" "$profiles" > "/tmp/phase6-request-io-guest-$repeat.log" 2>&1
 cp "/tmp/phase6-request-io-guest-$repeat.log" "$record/guest-final-$repeat.log"
 for file in "$profiles/"*.profraw; do
  cp "$file" "$CARGO_LLVM_COV_TARGET_DIR/request-guest-$repeat-${file##*/}"
 done
done
result=0
sh "$record/run-qemu.sh" "$PWD/target/phase6-request-io-controls/half-buffer-unit" "$kernel_root" "$record/control-half-buffer" "$PWD/target/phase6-request-io-controls/guest-profiles" > /tmp/phase6-request-io-guest-control.log 2>&1 || result=$?
cp /tmp/phase6-request-io-guest-control.log "$record/control-half-buffer.log"
test "$result" = 1
grep -q 'GUEST_COVERAGE_RESULT=101' "$record/control-half-buffer/run.log"
grep -q 'test result: FAILED. 0 passed; 1 failed' "$record/control-half-buffer/run.log"
grep -q 'left: 8388608' "$record/control-half-buffer/run.log"
grep -q 'right: 16777216' "$record/control-half-buffer/run.log"
printf 'REQUEST_IO_THREE_GUESTS_AND_FORCE_CONTROL_RESULT=0\n'
