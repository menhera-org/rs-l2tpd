--- a/src/reconciler/mod.rs
+++ b/src/reconciler/mod.rs
@@ -539,3 +539,64 @@
 #[cfg(test)]
 #[cfg_attr(coverage_nightly, coverage(off))]
 pub(crate) mod tests;
+
+#[cfg(all(test, feature = "fake-kernel", feature = "serde"))]
+#[cfg_attr(coverage_nightly, coverage(off))]
+mod address_bound_witness {
+    use super::*;
+    use crate::kernel::fake::FakeKernel;
+    use std::net::{IpAddr, Ipv4Addr};
+
+    #[test]
+    fn retained_addresses_with_one_configured_tunnel() {
+        for count in [100u32, 1_000, 10_000] {
+            let mut kernel = FakeKernel::new(42);
+            let device = kernel.add_link("wan", false);
+            kernel.set_up(device, true);
+            for offset in 1..=count {
+                kernel.add_addr(device, IpAddr::V4(Ipv4Addr::from(0x0a000000 + offset)));
+            }
+            let config: Config = toml::from_str(
+                "[tunnels.a]\ntunnel_id=10\nremote_addr='192.0.2.2'\nbind_interface='wan'\n",
+            )
+            .unwrap();
+            let mut r = Reconciler::new(kernel, Box::new(IphostResolve::default()));
+            assert!(r.reconcile(config));
+            assert_eq!(r.accepted.tunnels().len(), 1);
+            let retained: usize = r.addresses.values().map(BTreeSet::len).sum();
+            println!(
+                "CONFIGURED_TUNNELS=1 CURRENT_DEVICE_ADDRESSES={count} RETAINED_ADDRESSES={retained}"
+            );
+            assert_eq!(retained, count as usize);
+            assert!(r.shutdown());
+        }
+    }
+
+    #[test]
+    fn retained_members_with_one_configured_vrf_binding() {
+        for count in [100u32, 1_000, 10_000] {
+            let mut kernel = FakeKernel::new(42);
+            let vrf = kernel.add_link("vrf0", true);
+            kernel.set_up(vrf, true);
+            for offset in 1..=count {
+                let member = kernel.add_link(&format!("m{offset}"), false);
+                kernel.set_master(member, Some(vrf));
+            }
+            let config: Config = toml::from_str(
+                "[tunnels.a]\ntunnel_id=10\nremote_addr='192.0.2.2'\nbind_interface='vrf0'\n",
+            )
+            .unwrap();
+            let mut r = Reconciler::new(kernel, Box::new(IphostResolve::default()));
+            assert!(r.reconcile(config));
+            assert_eq!(r.accepted.tunnels().len(), 1);
+            println!(
+                "CONFIGURED_TUNNELS=1 CURRENT_VRF_MEMBERS={count} RETAINED_MASTERS={} RETAINED_MEMBERS={}",
+                r.masters.len(),
+                r.members[&vrf].len()
+            );
+            assert_eq!(r.masters.len(), count as usize);
+            assert_eq!(r.members[&vrf].len(), count as usize);
+            assert!(r.shutdown());
+        }
+    }
+}
