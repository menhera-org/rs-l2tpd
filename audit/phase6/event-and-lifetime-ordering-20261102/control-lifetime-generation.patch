+
+    // kernel: (K29, K36) netlink receive deadlines, failed reopen and generation loss.
+    /// spec: A7, A13, E20, E21, M18, S9
+    #[test]
+    #[ignore = "isolated live namespace; traced workers must not inherit concurrent fake descriptors"]
+    fn reader_and_failed_send_ordering_preserve_the_current_generation() {
+        use std::io::{Read, Write};
+        use std::os::unix::net::{UnixListener, UnixStream};
+        const CHILD: &str = "PHASE6_LIFETIME_ORDERING";
+        const CASE: &str = "kernel::linux::lifetime::tests::reader_and_failed_send_ordering_preserve_the_current_generation";
+        if let Some(mode) = std::env::var_os(CHILD) {
+            let mode = mode.to_str().unwrap();
+            nix::sched::unshare(nix::sched::CloneFlags::CLONE_NEWNET).unwrap();
+            let directory = std::env::var_os("PHASE6_LIFETIME_ORDERING_DIRECTORY").unwrap();
+            let listener =
+                UnixListener::bind(std::path::Path::new(&directory).join("control")).unwrap();
+            let mut initial = state();
+            initial.socket = Some(Arc::new(if mode == "changed-send" {
+                let mut socket = Socket::new(netlink_sys::protocols::NETLINK_USERSOCK).unwrap();
+                socket.bind_auto().unwrap();
+                socket.connect(&SocketAddr::new(0, 0)).unwrap();
+                socket
+            } else {
+                open().unwrap()
+            }));
+            initial.tracked.insert((1, 1), false);
+            let shared = Arc::new(Shared {
+                state: Mutex::new(initial),
+                changed: Condvar::new(),
+            });
+            if mode == "reopen" {
+                super::super::syscall_fault::refuse(
+                    &[
+                        #[cfg(target_arch = "x86_64")]
+                        libc::SYS_poll,
+                        libc::SYS_ppoll,
+                        libc::SYS_recvfrom,
+                    ],
+                    libc::EIO,
+                );
+                super::super::syscall_fault::refuse(&[libc::SYS_socket], libc::EMFILE);
+            }
+            let stopped = shared.clone();
+            let change_generation = mode == "changed-send";
+            let notify = std::thread::spawn(move || {
+                let (channel, _) = listener.accept().unwrap();
+                // Use read/write syscalls; the reader fixture refuses recvfrom.
+                let descriptor: std::os::fd::OwnedFd = channel.into();
+                let mut channel = std::fs::File::from(descriptor);
+                let mut byte = [0];
+                channel.read_exact(&mut byte).unwrap();
+                assert_eq!(byte, [1]);
+                let mut state = stopped.lock();
+                if change_generation {
+                    state.end_generation();
+                    state.tracked.insert((2, 2), false);
+                } else {
+                    state.stop = true;
+                }
+                stopped.changed.notify_all();
+                channel.write_all(&[1]).unwrap();
+            });
+            super::super::syscall_barrier::stop().unwrap();
+            if mode == "changed-send" {
+                let lifetime = Lifetime {
+                    shared: shared.clone(),
+                    thread: None,
+                };
+                assert_eq!(lifetime.prove(&Registration::new(1, 0, 1)), Proof::Lost);
+            } else {
+                read(shared.clone());
+            }
+            notify.join().unwrap();
+            let state = shared.lock();
+            match mode {
+                "changed-send" => {
+                    assert_eq!(
+                        state.generation, 1,
+                        "failed send ended the newer generation"
+                    );
+                    assert_eq!(state.tracked, BTreeMap::from([((2, 2), false)]));
+                    assert!(state.lookups.is_empty());
+                }
+                "reopen" => {
+                    assert_eq!(state.generation, 1);
+                    assert!(
+                        state.socket.is_none()
+                            && state.tracked.is_empty()
+                            && state.lookups.is_empty()
+                    );
+                }
+                "quiet-reader" => {
+                    assert_eq!(state.generation, 0);
+                    assert_eq!(state.tracked, BTreeMap::from([((1, 1), false)]));
+                }
+                _ => unreachable!(),
+            }
+            println!("LIFETIME_ORDERING_CHECKED={mode}");
+            return;
+        }
+        for mode in ["changed-send", "reopen", "quiet-reader"] {
+            let directory = crate::testdir::Dir::new();
+            let mut command = std::process::Command::new(std::env::current_exe().unwrap());
+            command
+                .args([
+                    "--ignored",
+                    "--exact",
+                    CASE,
+                    "--nocapture",
+                    "--test-threads=1",
+                ])
+                .env(CHILD, mode)
+                .env("PHASE6_LIFETIME_ORDERING_DIRECTORY", directory.path());
+            let mut checked = false;
+            let output = super::super::syscall_barrier::run(
+                &mut command,
+                directory.path(),
+                |_, number, _| {
+                    if checked {
+                        return Ok(());
+                    }
+                    let selected = match mode {
+                        "changed-send" => {
+                            number == libc::SYS_sendto as u64 || number == libc::SYS_sendmsg as u64
+                        }
+                        "reopen" => {
+                            number == libc::SYS_clock_nanosleep as u64
+                                || number == libc::SYS_nanosleep as u64
+                        }
+                        "quiet-reader" => number == libc::SYS_recvfrom as u64,
+                        _ => unreachable!(),
+                    };
+                    if selected {
+                        let mut channel = UnixStream::connect(directory.path().join("control"))?;
+                        channel.set_read_timeout(Some(Duration::from_secs(5)))?;
+                        channel.write_all(&[1])?;
+                        let mut byte = [0];
+                        channel.read_exact(&mut byte)?;
+                        assert_eq!(byte, [1]);
+                        checked = true;
+                    }
+                    Ok(())
+                },
+            )
+            .unwrap();
+            assert!(output.status.success(), "mode={mode}: {output:?}");
+            assert!(checked, "mode={mode} never reached its ordered syscall");
+            assert!(
+                String::from_utf8_lossy(&output.stdout)
+                    .contains(&format!("LIFETIME_ORDERING_CHECKED={mode}"))
+            );
+        }
+    }
 }
