+#[cfg(all(test, feature = "fake-kernel", feature = "serde"))]
+#[cfg_attr(coverage_nightly, coverage(off))]
+mod boundary_tests {
+    use super::*;
+    use crate::kernel::fake::FakeKernel;
+    use crate::reconciler::{IphostResolve, Request};
+
+    /// spec: T26, T7, E12, E25, G20
+    #[test]
+    fn provisional_socket_failures_and_a_tunable_race_release_ownership_before_retry() {
+        for case in ["only-v6", "link", "tunable-race"] {
+            let mut kernel = FakeKernel::new(42);
+            let link = kernel.add_link("eth", false);
+            kernel.add_addr(link, "192.0.2.1".parse().unwrap());
+            let mut r = Reconciler::new(kernel, Box::new(IphostResolve::default()));
+            let config: crate::config::Config = toml::from_str(
+                "[tunnels.a]\ntunnel_id=10\nremote_addr='192.0.2.2'\nbind_interface='eth'\n",
+            )
+            .unwrap();
+            match case {
+                "only-v6" => r.k.set_only_v6_error(Some(Errno::EIO)),
+                "link" => r.k.fail_next("link", Errno::EIO),
+                // The host can change bindv6only after the scratch check.
+                "tunable-race" => r.k.set_bindv6only(true),
+                _ => unreachable!(),
+            }
+            let error = r.create_tunnel("a", &config.tunnels()["a"]).unwrap_err();
+            assert_eq!(r.k.open_sockets(), 0, "{case}");
+            assert!(r.tunnels.is_empty());
+            assert!(r.k.tunnel(10).unwrap().is_none());
+            let requests = r.take_requests();
+            if case == "tunable-race" {
+                assert_eq!(error.kind(), io::ErrorKind::WouldBlock);
+                let [Request::WriteBindv6only { id, .. }] = requests.as_slice() else {
+                    panic!("a newly observed IPv6-only socket needs one host request");
+                };
+                r.k.set_bindv6only(false);
+                r.tunable_written(*id, true);
+            } else {
+                assert_eq!(error.raw_os_error(), Some(Errno::EIO as i32));
+                assert!(requests.is_empty());
+                r.k.set_only_v6_error(None);
+            }
+            assert!(r.reconcile(config));
+            assert!(r.ready());
+            assert_eq!(r.k.open_sockets(), 1);
+            assert!(r.shutdown());
+            assert_eq!(r.k.open_sockets(), 0);
+        }
+    }
+}
