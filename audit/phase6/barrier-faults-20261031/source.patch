     use nix::sys::socket::{ControlMessageOwned, recvmsg};
     use std::io::IoSliceMut;
     use std::time::Duration;
+
+    /// spec: P14, P17, G14
+    #[test]
+    fn failed_barrier_operations_preserve_errors_and_release_local_pipes() {
+        const CHILD: &str = "PHASE6_BARRIER_FAULT";
+        if let Ok(case) = std::env::var(CHILD) {
+            let dir = crate::testdir::Dir::new();
+            let path = dir.path().join("notify");
+            let listener = UnixDatagram::bind(&path).unwrap();
+            listener
+                .set_read_timeout(Some(Duration::from_secs(3)))
+                .unwrap();
+            let listener = std::sync::Arc::new(listener);
+            let store = Store::new(path.as_os_str()).unwrap();
+            let manager = case.starts_with("read").then(|| {
+                let listener = listener.clone();
+                std::thread::spawn(move || {
+                    let mut bytes = [0; 32];
+                    let mut iov = [IoSliceMut::new(&mut bytes)];
+                    let mut cmsg = nix::cmsg_space!([i32; 1]);
+                    let message = recvmsg::<()>(
+                        listener.as_raw_fd(),
+                        &mut iov,
+                        Some(&mut cmsg),
+                        MsgFlags::MSG_CMSG_CLOEXEC,
+                    )
+                    .unwrap();
+                    assert_eq!(message.bytes, 9);
+                    let mut received = 0;
+                    for control in message.cmsgs().unwrap() {
+                        if let ControlMessageOwned::ScmRights(fds) = control {
+                            for fd in fds {
+                                drop(unsafe { OwnedFd::from_raw_fd(fd) });
+                                received += 1;
+                            }
+                        }
+                    }
+                    assert_eq!(received, 1);
+                })
+            });
+            let poll_syscalls: &[libc::c_long] = &[
+                libc::SYS_ppoll,
+                #[cfg(target_arch = "x86_64")]
+                libc::SYS_poll,
+            ];
+            let (syscalls, error) = match case.as_str() {
+                "pipe" => (&[libc::SYS_pipe2][..], libc::EMFILE),
+                "send" => (&[libc::SYS_sendmsg][..], libc::EIO),
+                "poll" => (poll_syscalls, libc::EIO),
+                "poll-interrupted" => (poll_syscalls, libc::EINTR),
+                "read" => (&[libc::SYS_read][..], libc::EIO),
+                "read-interrupted" => (&[libc::SYS_read][..], libc::EINTR),
+                _ => panic!("unknown barrier fault"),
+            };
+            crate::syscall_fault::refuse(syscalls, error);
+            let descriptors = || std::fs::read_dir("/proc/self/fd").unwrap().count();
+            let before = descriptors();
+            let error = store
+                .barrier(Instant::now() + Duration::from_millis(200))
+                .unwrap_err();
+            if case.ends_with("interrupted") {
+                assert_eq!(error.kind(), io::ErrorKind::TimedOut);
+            } else {
+                assert_eq!(
+                    error.raw_os_error(),
+                    Some(if case == "pipe" {
+                        libc::EMFILE
+                    } else {
+                        libc::EIO
+                    })
+                );
+            }
+            if let Some(manager) = manager {
+                manager.join().unwrap();
+            }
+            assert_eq!(descriptors(), before);
+            println!("BARRIER_FAULT_CHECKED={case}");
+            return;
+        }
+        for case in [
+            "pipe",
+            "send",
+            "poll",
+            "poll-interrupted",
+            "read",
+            "read-interrupted",
+        ] {
+            let output = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "fdstore::tests::failed_barrier_operations_preserve_errors_and_release_local_pipes", "--nocapture", "--test-threads=1"])
+                .env(CHILD, case).output().unwrap();
+            assert!(output.status.success(), "{case}: {output:?}");
+            assert!(
+                String::from_utf8_lossy(&output.stdout)
+                    .contains(&format!("BARRIER_FAULT_CHECKED={case}"))
+            );
+            assert!(!String::from_utf8_lossy(&output.stderr).contains("LLVM Profile Error"));
+            println!("BARRIER_FAULT_VERIFIED={case}");
+        }
+    }
