+// kernel: (K1, K21, K41) net/netlink/genetlink.c ctrl_fill_info advertises the family and its groups.
+fn family_info(payload: &[u8]) -> io::Result<(u16, Option<u32>)> {
+    let proto = |_| errno(libc::EPROTO);
+    let header = GenlHeader::parse(payload).map_err(proto)?;
+    let ctrl = GenlCtrl::parse_with_param(payload.get(GENL_HDRLEN..).unwrap_or_default(), header)
+        .map_err(proto)?;
+    let (mut id, mut group) = (None, None);
+    for nla in ctrl.nlas {
+        match nla {
+            GenlCtrlAttrs::FamilyId(v) => id = Some(v),
+            GenlCtrlAttrs::McastGroups(groups) => {
+                group = groups
+                    .iter()
+                    .filter(|g| g.contains(&McastGrpAttrs::Name(FAMILY.into())))
+                    .flatten()
+                    .find_map(|a| match a {
+                        McastGrpAttrs::Id(id) => Some(*id),
+                        _ => None,
+                    });
+            }
+            _ => {}
+        }
+    }
+    Ok((id.ok_or_else(|| errno(libc::EPROTO))?, group))
