+    let all = f.k().dump_links().unwrap();
+    assert!(
+        [master, other_master, member, noise, empty]
+            .iter()
+            .all(|index| all.iter().any(|link| link.index() == *index))
+    );
+    let all = f.k().dump_addrs().unwrap();
+    assert!(
+        all.iter().any(|addr| addr.index() == noise
