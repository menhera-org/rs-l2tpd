+
+/// spec: C6, C10, C16, O4
+#[test]
+fn document_diagnostics_quote_nonbare_keys_and_explain_ignored_fields() {
+    for (key, rendered) in [
+        ("", "\"\""),
+        ("-", "-"),
+        ("_", "_"),
+        ("a.b", "\"a.b\""),
+        ("line\nbreak", "\"line\\nbreak\""),
+    ] {
+        let (config, problems) = lenient(&format!("{key:?} = 1\n"));
+        assert_eq!(config, Config::new());
+        assert_eq!(problems.len(), 1);
+        assert_eq!(
+            problems[0].to_string(),
+            format!("{rendered}: unknown key; ignored")
+        );
+    }
+    let (config, problems) =
+        lenient("[resolvers.r]\nmethod='ra'\nbind_interface='wan'\ndhcpv6_identity='anonymous'\n");
+    assert_eq!(
+        config.resolvers()["r"].dhcpv6_identity(),
+        &Dhcpv6Identity::LinkLayer
+    );
+    assert_eq!(problems.len(), 1);
+    assert_eq!(
+        problems[0].to_string(),
+        "resolver \"r\", dhcpv6_identity: used only with method dhcpv6 or ipv6; applied, the key ignored"
+    );
+}
