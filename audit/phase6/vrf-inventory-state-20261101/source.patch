+/// spec: H7, H14, E6, E7, M16, G23
+#[test]
+#[ignore = "disposable privileged container"]
+fn reload_adds_vrf_binding_and_tracks_existing_sibling_addresses() {
+    let pair = Pair::new();
+    pair.underlay(true, false);
+    for side in 0..2 {
+        pair.ip(
+            side,
+            &["link", "add", "vrfA", "type", "vrf", "table", "100"],
+        );
+        pair.ip(side, &["link", "set", "vrfA", "up"]);
+        pair.ip(side, &["link", "set", "underlay", "master", "vrfA"]);
+        pair.ip(side, &["link", "add", "sibling", "type", "dummy"]);
+        pair.ip(side, &["link", "set", "sibling", "master", "vrfA"]);
+        pair.ip(side, &["link", "set", "sibling", "up"]);
+    }
+    let initial = |side, peer| {
+        config(side, &[peer]).replace("[sessions.", "bind_interface='underlay'\n[sessions.")
+    };
+    let mut a = pair.start(0, &initial(0, "192.0.2.2"));
+    let mut b = pair.start(1, &initial(1, "192.0.2.1"));
+    a.event("ready");
+    b.event("ready");
+    let original = pair.index(0, "l2tp0");
+    pair.inner("l2tp0", 0);
+    pair.frames(0);
+    for (side, peer, daemon) in [(0, "192.0.2.2", &a), (1, "192.0.2.1", &b)] {
+        let text = config(side, &[peer, peer])
+            .replace("[tunnels.t0]", "[tunnels.t0]\nbind_interface='underlay'")
+            .replace("[tunnels.t1]", "[tunnels.t1]\nbind_interface='vrfA'");
+        std::fs::write(pair.dir.join(format!("{side}.toml")), text).unwrap();
+        daemon.reload();
+    }
+    assert_eq!(pair.index(0, "l2tp0"), original);
+    let added = pair.index(0, "l2tp1");
+    pair.inner("l2tp1", 1);
+    pair.frames(0);
+    pair.frames(1);
+    let member = "tunnel t0 (tunnel_id=1): connected to";
+    let vrf = "tunnel t1 (tunnel_id=11): connected to";
+    let before = (a.count(member), a.count(vrf));
+    assert!(before.0 > 0 && before.1 > 0);
+    for (operation, extra) in [("add", 1), ("del", 2)] {
+        pair.ip(0, &["addr", operation, "198.51.100.9/24", "dev", "sibling"]);
+        super::support::wait("VRF sibling address reconnect", || {
+            a.count(vrf) >= before.1 + extra
+        });
+        assert_eq!(
+            (a.count(member), a.count(vrf)),
+            (before.0, before.1 + extra)
+        );
+        assert_eq!(pair.index(0, "l2tp0"), original);
+        assert_eq!(pair.index(0, "l2tp1"), added);
+        pair.frames(0);
+        pair.frames(1);
+    }
+    a.stop();
+    b.stop();
+    pair.absent(0);
+    pair.absent(1);
+}
