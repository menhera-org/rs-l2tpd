+
+/// Diagnostic for kernels with K41 all-namespace deletion announcements.
+#[test]
+#[ignore = "isolated kernel test; K41 all-namespace kernel required"]
+fn colliding_foreign_deletions_explain_shared_kernel_request_counts() {
+    for foreign_count in [2, 4] {
+        for collide in [false, true] {
+            let pair = Pair::new();
+            pair.underlay(true, false);
+            let mut a = pair.start(0, &configured(0, 4));
+            let mut b = pair.start(1, &configured(1, 4));
+            a.event("ready");
+            b.event("ready");
+            for n in 0..4 {
+                pair.inner(&format!("l2tp{n}"), n);
+                pair.frames(n);
+            }
+            let foreign = Pair::new();
+            foreign.underlay(true, false);
+            let mut text = configured(0, foreign_count);
+            if !collide {
+                for n in 0..foreign_count {
+                    let id = 10 * n + 1;
+                    text = text.replace(
+                        &format!("tunnel_id={id}\n"),
+                        &format!("tunnel_id={}\n", id + 10000),
+                    );
+                    text = text.replace(
+                        &format!("session_id={}\n", id + 100),
+                        &format!("session_id={}\n", id + 10100),
+                    );
+                }
+            }
+            let mut other = foreign.start(0, &text);
+            other.event("ready");
+            let trace = RouteTrace::start(&pair, 0);
+            other.stop();
+            let until = Instant::now() + Duration::from_millis(2200);
+            while Instant::now() < until {
+                if !collide {
+                    assert_eq!(trace.snapshot().requests, 0);
+                }
+                std::thread::sleep(Duration::from_millis(100));
+            }
+            let counts = trace.finish();
+            println!(
+                "K41_CROSS_TEST foreign_sessions={foreign_count} collide={collide} {counts:?}"
+            );
+            assert_eq!(counts.route_queries, 0);
+            if collide {
+                assert!(counts.requests > 0 && counts.generic_requests > 0);
+            } else {
+                assert_eq!(counts.requests, 0);
+            }
+            objects(&pair, 4);
+            for n in 0..4 {
+                pair.frames(n);
+            }
+            a.stop();
+            b.stop();
+        }
+    }
+}
