+// kernel: (K1, K29) net/netlink/af_netlink.c netlink_ack, netlink_dump_done;
+// include/uapi/linux/netlink.h completion types and NLM_F_DUMP_INTR.
+fn reply(
+    msg: Msg<'_>,
+    seq: u32,
+    answer: &mut io::Result<()>,
+    visit: &mut dyn FnMut(u16, &[u8]) -> io::Result<()>,
+) -> io::Result<ControlFlow<io::Result<()>>> {
+    if msg.seq != seq {
+        return Ok(ControlFlow::Continue(()));
+    }
+    if msg.flags & NLM_F_DUMP_INTR != 0 && answer.is_ok() {
+        *answer = Err(errno(libc::EINTR));
+    }
+    let code = match msg.kind {
+        NLMSG_ERROR => ErrorBuffer::new_checked(msg.payload)
+            .map_err(|_| errno(libc::EPROTO))?
+            .code()
+            .map_or(0, |code| code.get()),
+        NLMSG_DONE => DoneBuffer::new_checked(msg.payload).map_or(0, |done| done.code()),
+        kind if kind >= NLMSG_MIN_TYPE && answer.is_ok() => {
+            *answer = visit(kind, msg.payload);
+            return Ok(ControlFlow::Continue(()));
+        }
+        netlink_packet_core::NLMSG_OVERRUN => return Err(errno(libc::ENOBUFS)),
+        _ => return Ok(ControlFlow::Continue(())),
+    };
+    // A malformed signed status must not overflow or become a negative OS errno.
+    let code = code
+        .checked_neg()
+        .filter(|code| *code >= 0)
+        .ok_or_else(|| errno(libc::EPROTO))?;
+    Ok(ControlFlow::Break(
+        std::mem::replace(answer, Ok(())).and(if code == 0 { Ok(()) } else { Err(errno(code)) }),
+    ))
+}
