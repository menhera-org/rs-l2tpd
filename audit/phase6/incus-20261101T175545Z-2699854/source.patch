+#[cfg(test)]
+#[cfg_attr(coverage_nightly, coverage(off))]
+mod reply_tests {
+    use super::*;
+
+    // kernel: (K29) include/uapi/linux/netlink.h nlmsgerr and NLMSG_DONE status.
+    fn status(kind: u16, code: i32) -> Vec<u8> {
+        let mut payload = code.to_ne_bytes().to_vec();
+        if kind == NLMSG_ERROR {
+            payload.extend([0; HEADER]);
+        }
+        super::tests::message(kind, 7, &payload)
+    }
+
+    // kernel: (K1, K29) net/netlink/af_netlink.c netlink_ack uses a signed errno.
+    /// spec: G1, A14, E21
+    #[test]
+    fn minimum_status_in_an_ack_is_refused_without_panicking() {
+        let wire = status(NLMSG_ERROR, i32::MIN);
+        let msg = messages(&wire).unwrap().pop().unwrap();
+        let error = reply(msg, 7, &mut Ok(()), &mut |_, _| {
+            panic!("a malformed acknowledgement visited data")
+        })
+        .unwrap_err();
+        assert_eq!(error.raw_os_error(), Some(libc::EPROTO));
+    }
+
+    // kernel: (K29) net/netlink/af_netlink.c netlink_dump_done appends its signed status.
+    /// spec: G1, A14, E21
+    #[test]
+    fn minimum_status_in_a_done_is_refused_without_panicking() {
+        let wire = status(NLMSG_DONE, i32::MIN);
+        let msg = messages(&wire).unwrap().pop().unwrap();
+        let error = reply(msg, 7, &mut Ok(()), &mut |_, _| {
+            panic!("a malformed dump completion visited data")
+        })
+        .unwrap_err();
+        assert_eq!(error.raw_os_error(), Some(libc::EPROTO));
+    }
+
+    // kernel: (K29) net/netlink/af_netlink.c netlink_ack and netlink_dump_done carry signed status.
+    /// spec: A14, E21, G1
+    #[test]
+    fn completion_statuses_preserve_success_and_exact_kernel_errors() {
+        for kind in [NLMSG_ERROR, NLMSG_DONE] {
+            for (code, expected) in [
+                (0, None),
+                (-1, Some(1)),
+                (-libc::EEXIST, Some(libc::EEXIST)),
+                (i32::MIN + 1, Some(i32::MAX)),
+            ] {
+                let wire = status(kind, code);
+                let msg = messages(&wire).unwrap().pop().unwrap();
+                let ControlFlow::Break(result) = reply(msg, 7, &mut Ok(()), &mut |_, _| {
+                    panic!("a completion visited data")
+                })
+                .unwrap() else {
+                    panic!("completion did not finish the request")
+                };
+                assert_eq!(
+                    result.err().and_then(|error| error.raw_os_error()),
+                    expected
+                );
+            }
+        }
+    }
+
+    // kernel: (K29) include/uapi/linux/netlink.h nlmsgerr.error is zero or a negative errno.
+    /// spec: A14, E21, G1
+    #[test]
+    fn positive_statuses_and_truncated_acknowledgements_are_protocol_errors() {
+        for kind in [NLMSG_ERROR, NLMSG_DONE] {
+            for code in [1, i32::MAX] {
+                let wire = status(kind, code);
+                let msg = messages(&wire).unwrap().pop().unwrap();
+                assert_eq!(
+                    reply(msg, 7, &mut Ok(()), &mut |_, _| panic!(
+                        "malformed completion visited data"
+                    ))
+                    .unwrap_err()
+                    .raw_os_error(),
+                    Some(libc::EPROTO)
+                );
+            }
+        }
+        for size in 0..4 {
+            let wire = super::tests::message(NLMSG_ERROR, 7, &vec![0; size]);
+            let msg = messages(&wire).unwrap().pop().unwrap();
+            assert_eq!(
+                reply(msg, 7, &mut Ok(()), &mut |_, _| panic!(
+                    "short acknowledgement visited data"
+                ))
+                .unwrap_err()
+                .raw_os_error(),
+                Some(libc::EPROTO)
+            );
+            let wire = super::tests::message(NLMSG_DONE, 7, &vec![0; size]);
+            let msg = messages(&wire).unwrap().pop().unwrap();
+            assert!(matches!(
+                reply(msg, 7, &mut Ok(()), &mut |_, _| panic!(
+                    "empty completion visited data"
+                ))
+                .unwrap(),
+                ControlFlow::Break(Ok(()))
+            ));
+        }
+    }
+
+    // kernel: (K29) net/netlink/af_netlink.c netlink_ack preserves the request's sequence.
+    /// spec: A14, E21, E22
+    #[test]
+    fn an_abandoned_sequence_is_ignored_before_status_or_interruption() {
+        let mut answer = Ok(());
+        let msg = Msg {
+            kind: NLMSG_ERROR,
+            flags: NLM_F_DUMP_INTR,
+            seq: 6,
+            payload: &[],
+        };
+        assert!(matches!(
+            reply(msg, 7, &mut answer, &mut |_, _| panic!(
+                "stale reply visited data"
+            ))
+            .unwrap(),
+            ControlFlow::Continue(())
+        ));
+        assert!(answer.is_ok());
+    }
+
+    // kernel: (K29) net/netlink/af_netlink.c netlink_dump_done terminates the drained multipart reply.
+    /// spec: A14, E21, G1
+    #[test]
+    fn the_first_visitor_error_survives_drain_interruption_and_completion() {
+        for (kind, code) in [
+            (NLMSG_ERROR, 0),
+            (NLMSG_ERROR, -libc::EINVAL),
+            (NLMSG_DONE, -libc::ENOENT),
+        ] {
+            let mut answer = Ok(());
+            let mut calls = 0;
+            let mut visit = |kind, bytes: &[u8]| {
+                calls += 1;
+                assert_eq!(kind, NLMSG_MIN_TYPE);
+                assert_eq!(bytes, b"first");
+                Err(io::Error::other("first visitor error"))
+            };
+            let first = Msg {
+                kind: NLMSG_MIN_TYPE,
+                flags: 0,
+                seq: 7,
+                payload: b"first",
+            };
+            assert!(matches!(
+                reply(first, 7, &mut answer, &mut visit).unwrap(),
+                ControlFlow::Continue(())
+            ));
+            let later = Msg {
+                kind: NLMSG_MIN_TYPE + 1,
+                flags: NLM_F_DUMP_INTR,
+                seq: 7,
+                payload: b"second",
+            };
+            assert!(matches!(
+                reply(later, 7, &mut answer, &mut visit).unwrap(),
+                ControlFlow::Continue(())
+            ));
+            let wire = status(kind, code);
+            let msg = messages(&wire).unwrap().pop().unwrap();
+            let ControlFlow::Break(result) = reply(msg, 7, &mut answer, &mut visit).unwrap() else {
+                panic!("completion did not finish")
+            };
+            assert_eq!(result.unwrap_err().to_string(), "first visitor error");
+            assert_eq!(calls, 1);
+        }
+    }
+
+    // kernel: (K29) net/netlink/af_netlink.c netlink_dump_done reports NLM_F_DUMP_INTR.
+    /// spec: A14, E21
+    #[test]
+    fn an_interrupted_dump_never_visits_more_data_or_reports_success() {
+        let mut answer = Ok(());
+        let msg = Msg {
+            kind: NLMSG_MIN_TYPE,
+            flags: NLM_F_DUMP_INTR,
+            seq: 7,
+            payload: b"data",
+        };
+        assert!(matches!(
+            reply(msg, 7, &mut answer, &mut |_, _| panic!(
+                "interrupted dump visited data"
+            ))
+            .unwrap(),
+            ControlFlow::Continue(())
+        ));
+        let wire = status(NLMSG_DONE, 0);
+        let msg = messages(&wire).unwrap().pop().unwrap();
+        let ControlFlow::Break(result) = reply(msg, 7, &mut answer, &mut |_, _| {
+            panic!("completion visited data")
+        })
+        .unwrap() else {
+            panic!("completion did not finish")
+        };
+        assert_eq!(result.unwrap_err().raw_os_error(), Some(libc::EINTR));
+    }
+
+    // kernel: (K29) include/uapi/linux/netlink.h NLMSG_NOOP and NLMSG_OVERRUN control multipart replies.
+    /// spec: A14, E21, G1
+    #[test]
+    fn data_is_visited_noops_are_ignored_and_overrun_is_transport_loss() {
+        let mut answer = Ok(());
+        let mut seen = vec![];
+        let mut visit = |kind, bytes: &[u8]| {
+            seen.push((kind, bytes.to_vec()));
+            Ok(())
+        };
+        for (kind, payload) in [
+            (NLMSG_MIN_TYPE, &b"data"[..]),
+            (netlink_packet_core::NLMSG_NOOP, &b"noop"[..]),
+            (0, &[][..]),
+        ] {
+            let msg = Msg {
+                kind,
+                flags: 0,
+                seq: 7,
+                payload,
+            };
+            assert!(matches!(
+                reply(msg, 7, &mut answer, &mut visit).unwrap(),
+                ControlFlow::Continue(())
+            ));
+        }
+        let msg = Msg {
+            kind: netlink_packet_core::NLMSG_OVERRUN,
+            flags: 0,
+            seq: 7,
+            payload: &[],
+        };
+        assert_eq!(
+            reply(msg, 7, &mut answer, &mut visit)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::ENOBUFS)
+        );
+        assert_eq!(seen, [(NLMSG_MIN_TYPE, b"data".to_vec())]);
+    }
+}
