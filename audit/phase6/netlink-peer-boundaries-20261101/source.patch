+    // kernel: (K7, K29) net/netlink/af_netlink.c netlink_autobind and netlink_unicast.
+    fn userspace_peers() -> (Socket, Socket) {
+        let mut client = Socket::new(netlink_sys::protocols::NETLINK_USERSOCK).unwrap();
+        let mut peer = Socket::new(netlink_sys::protocols::NETLINK_USERSOCK).unwrap();
+        let client_address = client.bind_auto().unwrap();
+        let peer_address = peer.bind_auto().unwrap();
+        assert_ne!(client_address.port_number(), 0);
+        assert_ne!(peer_address.port_number(), 0);
+        client.set_non_blocking(true).unwrap();
+        peer.set_non_blocking(true).unwrap();
+        client.connect(&peer_address).unwrap();
+        peer.connect(&client_address).unwrap();
+        (client, peer)
+    }
+
+    // kernel: (K29) include/uapi/linux/netlink.h NLMSG_HDRLEN and NLMSG_ALIGN.
+    /// spec: K29, E21, G1
+    #[test]
+    fn undersized_headers_and_lengths_return_protocol_errors_without_panics() {
+        for size in 1..HEADER {
+            assert_eq!(
+                messages(&vec![0; size]).err().unwrap().raw_os_error(),
+                Some(libc::EPROTO)
+            );
+        }
+        for length in 0..HEADER {
+            let mut message = super::tests::message(NLMSG_MIN_TYPE, 7, &[]);
+            message[..4].copy_from_slice(&(length as u32).to_ne_bytes());
+            assert_eq!(
+                messages(&message).err().unwrap().raw_os_error(),
+                Some(libc::EPROTO)
+            );
+        }
+        assert!(messages(&[]).unwrap().is_empty());
+    }
+
+    // kernel: (K29) net/netlink/af_netlink.c netlink_sendmsg; E21 deadlines precede transmission.
+    /// spec: A14, E21, K29
+    #[test]
+    fn an_expired_exchange_sends_nothing_to_its_peer() {
+        let (client, peer) = userspace_peers();
+        let payload = netlink_packet_route::RouteNetlinkMessage::GetLink(
+            netlink_packet_route::link::LinkMessage::default(),
+        );
+        let error = exchange(&client, 7, payload, false, Instant::now(), &mut |_, _| {
+            panic!("expired request visited a reply")
+        })
+        .unwrap_err();
+        assert_eq!(error.raw_os_error(), Some(libc::ETIMEDOUT));
+        assert_eq!(
+            peer.recv_from_full().unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+    }
+
+    // kernel: (K29) net/netlink/af_netlink.c netlink_recvmsg reports the sender in sockaddr_nl.
+    /// spec: A14, E21, E22, K29
+    #[test]
+    fn userspace_datagrams_are_rejected_before_framing_or_header_pid_is_trusted() {
+        for datagram in [vec![0xff], super::tests::message(NLMSG_DONE, 7, &[0; 4])] {
+            let (client, peer) = userspace_peers();
+            assert_eq!(peer.send(&datagram, 0).unwrap(), datagram.len());
+            let payload = netlink_packet_route::RouteNetlinkMessage::GetLink(
+                netlink_packet_route::link::LinkMessage::default(),
+            );
+            let deadline = Instant::now() + Duration::from_secs(1);
+            let error = exchange(&client, 7, payload, false, deadline, &mut |_, _| {
+                panic!("userspace reply reached the visitor")
+            })
+            .unwrap_err();
+            assert_eq!(error.raw_os_error(), Some(libc::ETIMEDOUT));
+            assert!(Instant::now() >= deadline);
+            // This also proves the request was transmitted before the deadline.
+            let (request, sender) = peer.recv_from_full().unwrap();
+            assert_ne!(sender.port_number(), 0);
+            let messages = messages(&request).unwrap();
+            assert_eq!(messages.len(), 1);
+            assert_eq!(messages[0].seq, 7);
+            assert_eq!(messages[0].flags, NLM_F_REQUEST | NLM_F_ACK);
+        }
+    }
 }
 
