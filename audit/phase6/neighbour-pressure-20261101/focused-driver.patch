diff --git a/tests/scenarios/scale.rs b/tests/scenarios/scale.rs
index a765529..9411fc2 100644
--- a/tests/scenarios/scale.rs
+++ b/tests/scenarios/scale.rs
@@ -242,3 +242,20 @@ fn three_hundred_tunnels_release_resources_and_ignore_unrelated_events() {
     pair.absent(0);
     pair.absent(1);
 }
+
+#[test]
+#[ignore = "diagnostic QEMU guest only; not an H17 timing qualification"]
+fn kernel_global_neighbour_budget_diagnostic() {
+    let pair = Pair::new();
+    pair.underlay(true, true);
+    let mut a = pair.start(0, &configured(0, 300));
+    let mut b = pair.start(1, &configured(1, 300));
+    a.event_with_timeout("ready", Duration::from_secs(180));
+    b.event_with_timeout("ready", Duration::from_secs(180));
+    objects(&pair, 300);
+    wire(&pair, 300);
+    a.stop_with_timeout(Duration::from_secs(180));
+    b.stop_with_timeout(Duration::from_secs(180));
+    pair.absent(0);
+    pair.absent(1);
+}
