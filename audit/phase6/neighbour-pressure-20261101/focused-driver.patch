diff --git a/tests/kernel/matrix-init.sh b/tests/kernel/matrix-init.sh
index 75290bc..5f28ebb 100755
--- a/tests/kernel/matrix-init.sh
+++ b/tests/kernel/matrix-init.sh
@@ -30,6 +30,39 @@ if ! grep -q 'l2tp_builtin=1' /proc/cmdline; then
         for module in l2tp_ip6 vrf bridge 8021q nlmon; do modprobe "$module"; done
     fi
 fi
+
+if [ "$mode" = pressure ]; then
+    echo 'scope: isolated guest ARP-budget concurrency control only'
+    fulls() {
+        ip -s ntable show | awk '$1 == "inet" && $2 == "arp_cache" { arp=1 } arp && $1 == "table_fulls" {print $2; exit}'
+    }
+    before=$(fulls)
+    [ -n "$before" ]
+    filter=scale::kernel_global_neighbour_budget_diagnostic
+    /scenarios --ignored --exact "$filter" --test-threads=1 --nocapture > /tmp/pressure-a.log 2>&1 &
+    pressure_a=$!
+    /scenarios --ignored --exact "$filter" --test-threads=1 --nocapture > /tmp/pressure-b.log 2>&1 &
+    pressure_b=$!
+    result_a=0; wait "$pressure_a" || result_a=$?
+    result_b=0; wait "$pressure_b" || result_b=$?
+    after=$(fulls)
+    [ -n "$after" ]
+    delta=$((after - before))
+    printf 'PARALLEL_A_RESULT=%s\nPARALLEL_B_RESULT=%s\nPARALLEL_TABLE_FULLS_DELTA=%s\n' "$result_a" "$result_b" "$delta"
+    cat /tmp/pressure-a.log /tmp/pressure-b.log
+    [ "$result_a" -ne 0 ] || [ "$result_b" -ne 0 ]
+    grep -q '100% packet loss' /tmp/pressure-a.log /tmp/pressure-b.log
+    [ "$delta" -gt 0 ]
+    before=$(fulls)
+    run_suite /scenarios --ignored --exact "$filter" --test-threads=1 --nocapture
+    after=$(fulls)
+    delta=$((after - before))
+    printf 'SERIAL_TABLE_FULLS_DELTA=%s\n' "$delta"
+    [ "$delta" = 0 ]
+    echo PRESSURE_CONTROL_RESULT=0
+    exit 0
+fi
+
 if [ "$mode" = no-ethernet ]; then
     modprobe l2tp_ip6
     # The guest alone owns this autoload policy; the test later loads the driver explicitly.
