+        assert_eq!(answers[&id], [address.parse::<IpAddr>().unwrap()]);
+    }
+    resolve
+        .watch(Lookup::new(2, "192.0.2.2".into(), system.clone()))
+        .unwrap();
+    assert_eq!(resolve.job(&resolve.watches[&1]).users, 1);
+    assert_eq!(resolve.job(&resolve.watches[&2]).users, 2);
+    resolve.unwatch(1);
