@@ -422,4 +420,69 @@ mod completion_tests {
         assert!(read_file(&path).unwrap_err().to_string().contains("16 MiB"));
         assert!(read_file(Path::new("/dev/null")).is_err());
     }
+    /// spec: C10 C12 P13 O4
+    #[test]
+    fn retained_entry_conflicts_refuse_reload_and_recovery_preserves_the_retained_value() {
+        const CHILD: &str = "RS_L2TPD_TEST_FILE_CONFLICT";
+        if std::env::var_os(CHILD).is_none() {
+            let output = std::process::Command::new(std::env::current_exe().unwrap())
+                .args([
+                    "--exact",
+                    "files::completion_tests::retained_entry_conflicts_refuse_reload_and_recovery_preserves_the_retained_value",
+                    "--nocapture",
+                ])
+                .env(CHILD, "1")
+                .output()
+                .unwrap();
+            assert!(
+                output.status.success(),
+                "{}{}",
+                String::from_utf8_lossy(&output.stdout),
+                String::from_utf8_lossy(&output.stderr)
+            );
+            let diagnostics = String::from_utf8(output.stderr).unwrap();
+            assert!(diagnostics.contains("ERROR"), "{diagnostics}");
+            assert!(
+                diagnostics.contains("the reload is refused"),
+                "{diagnostics}"
+            );
+            assert!(diagnostics.contains("WARN"), "{diagnostics}");
+            assert!(
+                diagnostics.contains("the values in force are kept"),
+                "{diagnostics}"
+            );
+            return;
+        }
+        crate::logger::init(true);
+        let dir = crate::testdir::Dir::new();
+        let main = dir.path().join("main.toml");
+        let dropins = dir.path().join("absent");
+        let previous: Config =
+            toml::from_str("[tunnels.a]\ntunnel_id=1\nremote_addr='192.0.2.1'\n[tunnels.b]\ntunnel_id=2\nremote_addr='192.0.2.2'\n").unwrap();
+        let retained = previous.tunnels()["a"].clone();
+        fs::write(
+            &main,
+            "[tunnels.a]\ntunnel_id=0\nremote_addr='192.0.2.9'\n[tunnels.b]\ntunnel_id=1\nremote_addr='192.0.2.2'\n",
+        )
+        .unwrap();
+        let loaded = load(&main, &dropins);
+        assert!(loaded.errors.is_empty());
+        let (startup, problems) = loaded.partial.into_config_lenient();
+        assert!(!problems.is_empty());
+        assert!(!startup.tunnels().contains_key("a"));
+        assert_eq!(startup.tunnels()["b"].tunnel_id(), 1);
+        assert!(matches!(
+            reload(&main, &dropins, previous.clone()),
+            Err(Error::InvalidConfig(message))
+                if message == "reload refused; previous configuration retained"
+        ));
+        fs::write(
+            &main,
+            "[tunnels.a]\ntunnel_id=0\nremote_addr='192.0.2.9'\n[tunnels.b]\ntunnel_id=3\nremote_addr='192.0.2.2'\n",
+        )
+        .unwrap();
+        let accepted = reload(&main, &dropins, previous).unwrap();
+        assert_eq!(accepted.tunnels()["a"], retained);
+        assert_eq!(accepted.tunnels()["b"].tunnel_id(), 3);
+    }
 }
