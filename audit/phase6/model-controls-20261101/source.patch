+/// spec: K31, S12
+#[test]
+fn model_mac_changes_distinguish_ordinary_links_and_up_session_devices() {
+    let mut k = FakeKernel::new(7);
+    let ordinary = k.add_link("ordinary", false);
+    k.set_up(ordinary, true);
+    let original_link = k.link(ordinary).unwrap().clone();
+    let changed = HwAddr::new([2, 0, 0, 0, 0, 1]).unwrap();
+    k.set_hwaddr(ordinary, changed).unwrap();
+    assert_eq!(k.link(ordinary), Some(&original_link));
+    assert_eq!(k.ether_addr(ordinary).unwrap(), Some(changed));
+
+    let socket = k.create_socket(Family::V6, 100, 200).unwrap();
+    k.register_tunnel(socket, 100, 200).unwrap();
+    let session = k
+        .create_session(&SessionCreate::new(
+            100,
+            101,
+            201,
+            None,
+            None,
+            name("session"),
+        ))
+        .unwrap();
+    let index = session.index();
+    let initial = k.ether_addr(index).unwrap().unwrap();
+    k.set_up(index, true);
+    k.set_hwaddr(index, initial).unwrap();
+    assert_eq!(errno(k.set_hwaddr(index, changed)), nix::libc::EBUSY);
+    assert_eq!(k.ether_addr(index).unwrap(), Some(initial));
+    k.set_up(index, false);
+    k.set_hwaddr(index, changed).unwrap();
+    k.set_up(index, true);
+    k.set_hwaddr(index, changed).unwrap();
+    assert_eq!(errno(k.set_hwaddr(index, initial)), nix::libc::EBUSY);
+    assert_eq!(k.ether_addr(index).unwrap(), Some(changed));
+    k.close(socket);
+    k.tick();
+    assert!(k.link(index).is_none());
+    assert_eq!(k.link(ordinary), Some(&original_link));
+    assert_eq!(k.ether_addr(ordinary).unwrap(), Some(changed));
+}
