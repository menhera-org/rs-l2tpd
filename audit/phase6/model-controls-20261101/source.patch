+/// spec: K28, K34, A5
+#[test]
+fn model_source_selection_keeps_vrf_local_and_stale_addresses_out_of_the_default_domain() {
+    let mut k = FakeKernel::new(7);
+    let vrf = k.add_link("blue", true);
+    let vrf_source = "2001:db8:1::1".parse::<IpAddr>().unwrap();
+    k.add_addr(vrf, vrf_source);
+    let socket = k.create_socket(Family::V6, 100, 200).unwrap();
+    k.bind_index(socket, vrf).unwrap();
+    assert_eq!(
+        k.connect(socket, &peer("2001:db8::2", None)).unwrap(),
+        vrf_source
+    );
+    k.disconnect(socket).unwrap();
+    assert_eq!(
+        errno(k.connect(socket, &peer("2001:db8::2", None))),
+        nix::libc::EADDRNOTAVAIL
+    );
+    let stale_source = "2001:db8:2::1".parse::<IpAddr>().unwrap();
+    k.add_addr(999, stale_source);
+    assert_eq!(
+        errno(k.connect(socket, &peer("2001:db8::2", None))),
+        nix::libc::EADDRNOTAVAIL
+    );
+    k.add_link_at(999, "late", false);
+    assert_eq!(
+        k.connect(socket, &peer("2001:db8::2", None)).unwrap(),
+        stale_source
+    );
+    k.disconnect(socket).unwrap();
+    k.bind_index(socket, vrf).unwrap();
+    assert_eq!(
+        k.connect(socket, &peer("2001:db8::2", None)).unwrap(),
+        vrf_source
+    );
+    k.close(socket);
+    assert_eq!(k.open_sockets(), 0);
+}
