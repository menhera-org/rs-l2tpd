+/// spec: K19, K37, T7
+#[test]
+fn model_unregistered_socket_ids_release_only_after_the_final_external_descriptor() {
+    let mut k = FakeKernel::new(7);
+    let original = k.create_socket(Family::V6, 100, 200).unwrap();
+    let external = k.clone_fd(original).unwrap();
+    k.close(original);
+    assert_eq!(
+        errno(k.create_socket(Family::V6, 100, 200)),
+        nix::libc::EADDRINUSE
+    );
+    drop(external);
+    let replacement = k.create_socket(Family::V6, 100, 201).unwrap();
+    assert_ne!(replacement, original);
+    assert!(k.tunnel(100).unwrap().is_none());
+    k.tick();
+    assert_eq!(k.open_sockets(), 1);
+    assert!(!k.only_v6(replacement).unwrap());
+    k.close(replacement);
+    k.tick();
+    assert_eq!(k.open_sockets(), 0);
+}
