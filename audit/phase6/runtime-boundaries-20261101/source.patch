+/// spec: L6, L11, G23
+#[test]
+fn closed_admission_returns_errors_without_accepting_or_queuing_requests() {
+    engine().block_on(async {
+        let mut runtime = runtime();
+        let control = runtime.control();
+        control.shared.requests.close();
+        let generation = control.shared.generation.load(Ordering::Acquire);
+        let try_error = control.shared.requests.try_acquire().unwrap_err().to_string();
+        for error in [control.reload().unwrap_err(), control.restart().unwrap_err()] {
+            assert!(matches!(error, Error::Other(message) if message == try_error));
+        }
+        let wait_error = control.shared.requests.acquire().await.unwrap_err().to_string();
+        assert!(matches!(control.reload_wait().await, Err(Error::Other(message)) if message == wait_error));
+        assert_eq!(control.shared.generation.load(Ordering::Acquire), generation);
+        assert_eq!(control.shared.admitted.load(Ordering::Acquire), 0);
+        assert_eq!(control.shared.requests.available_permits(), QUEUE_CAPACITY);
+        assert_eq!(control.tx.capacity(), QUEUE_CAPACITY);
+        finish(&mut runtime);
+    });
+}
