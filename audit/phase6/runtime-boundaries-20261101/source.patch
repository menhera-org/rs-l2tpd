+/// spec: L13, P14
+#[test]
+fn adopted_identifiers_require_canonical_nonzero_names_and_retain_ownership() {
+    use std::io::{Read, Write};
+    use std::os::fd::AsRawFd;
+    use std::os::unix::net::UnixStream;
+    for (name, expected) in [
+        ("t1", Some(1)),
+        ("t4294967295", Some(u32::MAX)),
+        ("", None),
+        ("t", None),
+        ("t0", None),
+        ("t00", None),
+        ("t01", None),
+        ("t+1", None),
+        ("t-1", None),
+        ("T1", None),
+        ("t1 ", None),
+        ("t4294967296", None),
+    ] {
+        let (stream, mut peer) = UnixStream::pair().unwrap();
+        let original = stream.as_raw_fd();
+        let adopted = AdoptedSocket::new(name, stream.into());
+        assert_eq!(adopted.name(), name);
+        assert_eq!(adopted.tunnel_id(), expected, "{name:?}");
+        assert_eq!(adopted.fd().as_raw_fd(), original);
+        let (returned_name, fd) = adopted.into_parts();
+        assert_eq!(returned_name, name);
+        assert_eq!(fd.as_raw_fd(), original);
+        let mut stream = UnixStream::from(fd);
+        stream
+            .set_read_timeout(Some(Duration::from_secs(3)))
+            .unwrap();
+        peer.write_all(b"alive").unwrap();
+        let mut bytes = [0; 5];
+        stream.read_exact(&mut bytes).unwrap();
+        assert_eq!(&bytes, b"alive");
+    }
+}
