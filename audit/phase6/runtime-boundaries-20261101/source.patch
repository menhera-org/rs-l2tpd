+/// spec: L9, L11, L13, G20
+#[test]
+fn shutdown_request_and_started_shutdown_both_refuse_new_configuration() {
+    engine().block_on(async {
+        for request_only in [false, true] {
+            let mut runtime = runtime();
+            assert!(runtime.reconcile(Config::new()));
+            if request_only {
+                runtime.control().shutdown();
+            } else {
+                assert!(runtime.shutdown().unwrap());
+            }
+            runtime.reconciler.kernel_mut().clear_ops();
+            assert!(!runtime.reconcile(config()));
+            assert!(runtime.control().config().tunnels().is_empty());
+            assert!(runtime.reconciler.kernel().ops().is_empty());
+            finish(&mut runtime);
+        }
+    });
+}
