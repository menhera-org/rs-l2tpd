+/// spec: L8, L13, P25, G20
+#[test]
+fn shutdown_discards_tunable_work_that_the_program_has_not_received() {
+    engine().block_on(async {
+        let mut runtime = runtime();
+        runtime.reconciler.kernel_mut().set_bindv6only(true);
+        runtime.reconcile(config());
+        assert!(
+            runtime
+                .outgoing
+                .iter()
+                .any(|event| matches!(event, ControlEvent::WriteTunable { .. }))
+        );
+        runtime.shutdown().unwrap();
+        assert!(
+            !runtime
+                .outgoing
+                .iter()
+                .any(|event| matches!(event, ControlEvent::WriteTunable { .. }))
+        );
+        assert!(runtime.reconciler.kernel().bindv6only());
+        finish(&mut runtime);
+    });
+}
