+/// spec: L5, L7, L8, L9, G9, G14, G20
+#[test]
+#[ignore = "isolated live-kernel runner; both service constructors open real kernel interfaces"]
+fn public_service_constructors_converge_repeatedly_and_release_their_tunnels() {
+    use rs_l2tpd::config::{Config, HostConfig, TunnelConfig};
+    fn config(id: u32) -> Config {
+        let mut config = Config::new();
+        config.set_host(HostConfig::new().with_fix_bindv6only(false));
+        config
+            .insert_tunnel(
+                "api",
+                TunnelConfig::builder(id)
+                    .ip_version(Family::V6)
+                    .build()
+                    .unwrap(),
+            )
+            .unwrap();
+        config
+    }
+    let LinuxFixture {
+        mut kernel,
+        runtime,
+        ..
+    } = LinuxFixture::new();
+    runtime.block_on(async {
+        tokio::time::timeout(Duration::from_secs(10), async {
+            let mut service = rs_l2tpd::service::Service::new(config(10), vec![]).unwrap();
+            service.set_store_capacity(0).await.unwrap();
+            let requests = service.take_requests().unwrap();
+            assert!(service.take_requests().is_none());
+            drop(requests);
+            assert!(service.converge().await.unwrap().is_empty());
+            assert!(kernel.tunnel(10).unwrap().is_some());
+            assert!(service.converge().await.unwrap().is_empty());
+            assert!(
+                service
+                    .set_store_capacity(1)
+                    .await
+                    .unwrap_err()
+                    .to_string()
+                    .contains("before convergence")
+            );
+            service.control().shutdown();
+            service.run(Ok, |_| Ok(())).await.unwrap();
+            assert!(kernel.tunnel(10).unwrap().is_none());
+        })
+        .await
+        .expect("Tokio service lifecycle deadline");
+    });
+    let (tx, rx) = std::sync::mpsc::sync_channel(1);
+    let worker = std::thread::spawn(move || {
+        let result = (|| -> rs_l2tpd::Result<()> {
+            let mut service =
+                rs_l2tpd::blocking::Service::new(config(11), vec![]).map_err(|(error, _)| error)?;
+            let mut observer = LinuxKernel::new()?;
+            service.set_store_capacity(0)?;
+            let requests = service.take_requests()?.unwrap();
+            assert!(service.take_requests()?.is_none());
+            drop(requests);
+            assert!(service.converge()?.is_empty());
+            assert!(observer.tunnel(11)?.is_some());
+            assert!(service.converge()?.is_empty());
+            assert!(
+                service
+                    .set_store_capacity(1)
+                    .unwrap_err()
+                    .to_string()
+                    .contains("before convergence")
+            );
+            service.control().shutdown();
+            service.run(Ok, |_| Ok(()))?;
+            assert!(observer.tunnel(11)?.is_none());
+            Ok(())
+        })();
+        tx.send(result).unwrap();
+    });
+    rx.recv_timeout(Duration::from_secs(10))
+        .expect("blocking service lifecycle deadline")
+        .unwrap();
+    worker.join().unwrap();
+    assert!(kernel.tunnel(11).unwrap().is_none());
+}
