+    // kernel: (K20, K29) only RTM_NEWLINK/RTM_DELLINK carry lifetime evidence.
+    /// spec: E5, S9, S24, M18
+    #[test]
+    fn unrelated_or_unusable_multicast_records_preserve_capture_state() {
+        let mut state = state();
+        let from = SocketAddr::new(0, libc::RTNLGRP_LINK);
+        let name = L2tpIfName::new(b"owned").unwrap();
+        state.captures.insert(name, Capture::Armed);
+        state.tracked.insert((99, 1), false);
+        state.lookups.insert(7, Answer::Pending);
+        let mut truncated = link(libc::RTM_NEWLINK, 0, 8, b"owned");
+        truncated.truncate(19);
+        truncated[..4].copy_from_slice(&19u32.to_ne_bytes());
+        for ignored in [truncated, link(libc::RTM_GETLINK, 0, 8, b"owned")] {
+            state.receive(&ignored, &from);
+            assert_eq!(state.generation, 0);
+            assert_eq!(state.incarnations, 0);
+            assert!(matches!(state.captures.get(&name), Some(Capture::Armed)));
+            assert_eq!(state.tracked.len(), 1);
+            assert_eq!(state.tracked.get(&(99, 1)), Some(&false));
+            assert!(matches!(state.lookups.get(&7), Some(Answer::Pending)));
+        }
+        state.receive(&link(libc::RTM_NEWLINK, 0, 8, b"owned"), &from);
+        assert!(matches!(
+            state.captures.get(&name),
+            Some(Capture::Seen(8, 1))
+        ));
+        assert_eq!(state.tracked.get(&(8, 1)), Some(&false));
+        assert_eq!(state.tracked.get(&(99, 1)), Some(&false));
+        state.receive(&link(libc::RTM_DELLINK, 0, 8, b"owned"), &from);
+        assert_eq!(state.tracked.get(&(8, 1)), Some(&true));
+        assert_eq!(state.tracked.get(&(99, 1)), Some(&false));
+    }
+
