+    r.kernel_mut().del_addr(member, address);
+    deliver(&mut r);
+    assert!(r.kernel().connection(socket).is_none());
+    ops(&mut r);
+    for _ in 0..3 {
+        r.handle(
+            Source::Monitor,
+            Notice::AddrDel(AddrInfo::new(member, address)),
+        );
+    }
+    assert!(ops(&mut r).is_empty());
+    assert_eq!(r.kernel().tunnel_socket(10), Some(socket));
+}
