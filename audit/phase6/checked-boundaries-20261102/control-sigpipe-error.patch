+pub(super) fn ignore_pipe() -> io::Result<()> {
+    if { let _ = unsafe { libc::signal(libc::SIGPIPE, libc::SIG_IGN) }; false } {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
