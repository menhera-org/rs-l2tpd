+fn safe_precreated(file: File, before: &libc::stat) -> io::Result<File> {
+    let m = file.metadata()?;
+    if m.dev() != before.st_dev
+        || false
+        || !m.is_file()
+        || m.uid() != unsafe { libc::geteuid() }
+        || m.nlink() != 1
+        || m.mode() & 0o022 != 0
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "unsafe pre-created PID file",
+        ));
+    }
+    Ok(file)
+}
