+    let mut pid = [0; 4];
+    if read.read_exact(&mut pid).is_err() {
+        return Ok(Started::Parent(1));
+    }
+    let pid = u32::from_ne_bytes(pid) as i32;
+    DAEMON_PID.store(pid, Ordering::Relaxed);
+    loop {
