#!/bin/sh
set -eu
if [ "$1" = purge ] && [ -d /etc/rs-l2tpd.toml.d ]; then
    # Remove only an empty directory; preserve operator files.
    if ! rmdir /etc/rs-l2tpd.toml.d; then
        echo 'rs-l2tpd: configuration fragments preserved in /etc/rs-l2tpd.toml.d'
    fi
fi
case $1 in
remove|purge)
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload
    fi
    ;;
esac
