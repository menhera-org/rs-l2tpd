[Unit]
Description=Resilient L2TPv3 daemon
Before=network-online.target

[Service]
Type=forking
PIDFile=/run/rs-l2tpd/rs-l2tpd.pid
ExecStart=@BINARY@ --pid-file /run/rs-l2tpd/rs-l2tpd.pid
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=3
NotifyAccess=all
FileDescriptorStoreMax=65536
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
RuntimeDirectory=rs-l2tpd
RuntimeDirectoryMode=0755
ProtectSystem=strict
ReadWritePaths=/run/rs-l2tpd -/proc/sys/net/ipv6/bindv6only
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
InaccessiblePaths=-/var/log
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
RequiredBy=network-online.target
