FROM ubuntu:24.04 AS resolver
COPY . /packages
# Indexes and packages are fetched by build-systemd-image.sh on the caller.
# Keep authenticated lists for URI resolution and the offline install stage.
# hadolint ignore=DL3009
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources \
    && printf '%s\n' \
        'deb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] file:/packages noble main' \
        'deb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] file:/packages noble-updates main' \
        'deb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] file:/packages noble-security main' \
        > /etc/apt/sources.list \
    && apt-get -o Acquire::Languages=none -o Acquire::By-Hash=false update
CMD ["apt-get", "--print-uris", "--yes", "--no-install-recommends", "install", "dbus", "iproute2", "kmod", "procps", "systemd", "udev"]

FROM resolver AS runtime
ENV DEBIAN_FRONTEND=noninteractive
# Versions and SHA256 digests come from the authenticated indexes in /packages.
# hadolint ignore=DL3008
RUN apt-get install -y --no-install-recommends dbus iproute2 kmod procps systemd udev \
    && apt-get clean \
    && rm -rf /packages /var/lib/apt/lists/*
CMD ["/sbin/init"]
